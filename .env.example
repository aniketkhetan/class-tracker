# Supabase project settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Publishable key (sb_publishable_...). Safe in the browser. It has no
# privileges of its own and every request still goes through RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Secret key (sb_secret_...). Server only, bypasses RLS. Used by the daily
# nudge, which runs from cron with no signed-in user.
SUPABASE_SECRET_KEY=""

# Web push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret so only Vercel Cron can trigger the daily nudge.
CRON_SECRET=""
